{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --legacy-peer-deps && NEXT_PUBLIC_API_URL=https://sparkling-charm-production-cb2c.up.railway.app/api/v1 npm run build"
  },
  "deploy": {
    "startCommand": "node server.mjs",
    "restartPolicyType": "ON_FAILURE"
  }
}
