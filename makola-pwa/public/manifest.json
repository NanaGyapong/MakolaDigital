{
  "name": "Makola Digital",
  "short_name": "Makola",
  "description": "Africa's marketplace — buy, sell & connect across Africa and the diaspora",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0A0A0A",
  "theme_color": "#E8533A",
  "orientation": "portrait-primary",
  "lang": "en",
  "categories": ["shopping", "business", "lifestyle"],
  "scope": "/",
  "id": "makola-digital-pwa",

  "icons": [
    { "src": "/icons/icon-72.png",   "sizes": "72x72",   "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-96.png",   "sizes": "96x96",   "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-128.png",  "sizes": "128x128", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-144.png",  "sizes": "144x144", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-152.png",  "sizes": "152x152", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-192.png",  "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icons/icon-384.png",  "sizes": "384x384", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png",  "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],

  "screenshots": [
    {
      "src": "/screenshots/home-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Makola Digital home screen"
    },
    {
      "src": "/screenshots/search-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Search listings"
    },
    {
      "src": "/screenshots/home-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Makola Digital on desktop"
    }
  ],

  "shortcuts": [
    {
      "name": "Sell now",
      "short_name": "Sell",
      "description": "Create a new listing",
      "url": "/sell",
      "icons": [{ "src": "/icons/shortcut-sell.png", "sizes": "96x96" }]
    },
    {
      "name": "My messages",
      "short_name": "Messages",
      "description": "View your conversations",
      "url": "/messages",
      "icons": [{ "src": "/icons/shortcut-messages.png", "sizes": "96x96" }]
    },
    {
      "name": "Search listings",
      "short_name": "Search",
      "description": "Search the marketplace",
      "url": "/search",
      "icons": [{ "src": "/icons/shortcut-search.png", "sizes": "96x96" }]
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "images", "accept": ["image/*"] }]
    }
  },

  "protocol_handlers": [
    { "protocol": "web+makola", "url": "/?intent=%s" }
  ],

  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.makoladigital.app",
      "id": "com.makoladigital.app"
    }
  ],
  "prefer_related_applications": false
}
